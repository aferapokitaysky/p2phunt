DATABASE_URL="postgresql://p2phunt:p2phunt@localhost:55432/p2phunt?schema=public"
REDIS_URL="redis://localhost:56379"

# Fine to leave as-is for local dev. In production (NODE_ENV=production) the API and worker
# refuse to start unless these are overridden — generate real values, e.g.:
#   openssl rand -base64 48   (JWT secrets)
#   openssl rand -base64 32   (ENCRYPTION_KEY)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ENCRYPTION_KEY="change-me-32-byte-minimum-development-key"

WEB_ORIGIN="http://localhost:5173"
API_PORT="4000"
VITE_API_URL="http://localhost:4000"
VITE_WS_URL="http://localhost:4000"
